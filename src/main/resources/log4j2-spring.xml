<?xml version="1.0" encoding="UTF-8"?>
<!--
  Human-readable logging: console plus a rolling file.

  This is the default. Containers should instead set
      LOGGING_CONFIG=classpath:log4j2-json.xml
  which emits one JSON object per line for a log shipper. Two files rather than profile-conditional
  appenders in one, because log4j2's profile arbiters are not part of Spring Boot 3 and a silently
  ignored condition in a logging config is discovered at the worst possible moment.
-->
<Configuration status="WARN" monitorInterval="60">

    <Properties>
        <!--
          Every line carries the correlation id, so one request can be followed through the log. It is
          blank when not in scope, which is why it is bracketed and terse rather than labelled - a
          labelled empty field is noise on every unrelated line.
        -->
        <Property name="LOG_PATTERN">
            %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] [%X{correlationId}] %c{1.} - %msg%n%throwable
        </Property>

        <!-- Overridable so a container can write somewhere other than a relative directory. -->
        <Property name="LOG_DIR">${sys:LOG_DIR:-${env:LOG_DIR:-logs}}</Property>
        <Property name="APP_NAME">ledger-service</Property>
    </Properties>

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <RollingFile name="RollingFile"
                     fileName="${LOG_DIR}/${APP_NAME}.log"
                     filePattern="${LOG_DIR}/${APP_NAME}-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="20 MB"/>
            </Policies>
            <!--
              Bounded on purpose. Unbounded log retention fills a disk, and a service that cannot write
              is a service that is down - logs must never be the thing that takes the application with
              them. Old files are gzipped, since log text compresses very well.
            -->
            <DefaultRolloverStrategy max="10">
                <Delete basePath="${LOG_DIR}" maxDepth="1">
                    <IfFileName glob="${APP_NAME}-*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

    </Appenders>

    <Loggers>

        <!-- This service's own logs, where the interesting narrative is. -->
        <Logger name="com.natwest.ledger" level="DEBUG"/>

        <!--
          SQL is off by default. It is invaluable when diagnosing a query and pure noise otherwise, and
          left on it can put account identifiers and amounts into logs that are shipped and retained
          more widely than the database itself. Enable deliberately, never by default.
        -->
        <Logger name="org.hibernate.SQL" level="WARN"/>
        <Logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Root>

    </Loggers>

</Configuration>

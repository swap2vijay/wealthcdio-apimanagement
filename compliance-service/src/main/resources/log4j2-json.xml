<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured logging for containers. Select with LOGGING_CONFIG=classpath:log4j2-json.xml.
  Stdout only: in a container the log is a stream the platform collects, so a file inside the container
  would fill an ephemeral layer and hide the logs from the system meant to gather them.
-->
<Configuration status="WARN">

    <Appenders>
        <Console name="Json" target="SYSTEM_OUT">
            <!-- ECS, so the correlation id arrives as a queryable field rather than text in a message. -->
            <JsonTemplateLayout eventTemplateUri="classpath:EcsLayout.json"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="com.natwest.compliance" level="DEBUG"/>
        <Root level="INFO">
            <AppenderRef ref="Json"/>
        </Root>
    </Loggers>

</Configuration>

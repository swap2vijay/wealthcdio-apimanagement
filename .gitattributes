# Normalise to LF in the repository so diffs stay clean across Windows/Linux/CI.
* text=auto eol=lf

*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.properties text eol=lf
Jenkinsfile  text eol=lf
Dockerfile   text eol=lf

*.pdf    binary
*.jar    binary
*.png    binary
